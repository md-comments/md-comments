{
  "name": "md-preview-comments",
  "displayName": "Markdown Preview Comments",
  "description": "AI-orchestrated docs & human-orchestrated comments on rendered views. Powered by GitHub custom git refs (refs/md-comments/data). Works in VS Code, Cursor, and Antigravity.",
  "version": "1.4.7",
  "publisher": "md-comments",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "markdown",
    "comments",
    "cursor",
    "antigravity",
    "vscode",
    "review",
    "github"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/md-comments/md-comments.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onStartupFinished"
  ],
  "main": "./dist/vscode-extension/src/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "configurationDefaults": {
      "markdown.preview.openMarkdownLinks": "inEditor"
    },
    "commands": [
      {
        "command": "mdComments.openCommentPreview",
        "title": "Markdown Comments: Open Comment Preview",
        "icon": {
          "light": "./media/icons/comment-preview-light.svg",
          "dark": "./media/icons/comment-preview-dark.svg"
        }
      },
      {
        "command": "mdComments.openStandaloneCommentPreview",
        "title": "Markdown Comments: Open Standalone Comment Preview"
      },
      {
        "command": "mdComments.signIn",
        "title": "Markdown Comments: Sign In to GitHub"
      },
      {
        "command": "mdComments.signOut",
        "title": "Markdown Comments: Sign Out of GitHub"
      },
      {
        "command": "mdComments.handlePreviewAction",
        "title": "Markdown Comments: Handle Preview Action"
      },
      {
        "command": "mdComments.refreshPreview",
        "title": "Markdown Comments: Refresh Preview"
      },
      {
        "command": "mdComments.scanOrphans",
        "title": "Markdown Comments: Scan for Orphaned Comments"
      },
      {
        "command": "mdComments.toggleCommentPreview",
        "title": "Markdown Comments: Toggle Comment Preview",
        "icon": {
          "light": "./media/icons/comment-preview-light.svg",
          "dark": "./media/icons/comment-preview-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdComments.toggleCommentPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "mdComments.openCommentPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "mdComments.openCommentPreview",
          "when": "resourceLangId == markdown || resourceExtname == .md",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Comments",
      "properties": {
        "mdComments.oauthScope": {
          "type": "string",
          "enum": [
            "public_repo",
            "repo"
          ],
          "enumDescriptions": [
            "Least privilege: grants access to public repositories only (recommended).",
            "Grants access to both public and private repositories."
          ],
          "default": "public_repo",
          "description": "OAuth scope requested when signing in to GitHub"
        },
        "mdComments.sidebarWidth": {
          "type": "number",
          "default": 340,
          "minimum": 260,
          "maximum": 600,
          "description": "Default width (px) of the comments side panel in Markdown preview"
        },
        "mdComments.reactionEmojis": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "👍",
            "👀",
            "❤️",
            "🎉",
            "❓"
          ],
          "description": "Emoji options for reactions"
        },
        "mdComments.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error",
            "silent"
          ],
          "enumDescriptions": [
            "Full verbose debugging information.",
            "Informational messages, warnings, and errors.",
            "Warnings and errors only.",
            "Critical errors and exceptions only (default in release builds).",
            "Completely disable extension output channel logging."
          ],
          "description": "Log verbosity level. Defaults to 'error' on release builds and 'debug' during development."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit",
    "package": "pnpm dlx vsce-pnpm package --pnpm"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.2",
    "markdown-it": "^15.0.2"
  }
}
