# Telemetry Infrastructure & Cloudflare Credentials
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# Upstream Grafana Cloud / SigNoz OTLP Endpoint & Auth (for Cloudflare Proxy)
UPSTREAM_OTLP_ENDPOINT="https://otlp-gateway-prod-us-east-0.grafana.net/otlp"
UPSTREAM_AUTH_HEADER="Basic <base64_encoded_instance_and_token>"

# Terraform-specific bindings
TF_VAR_cloudflare_account_id="your_cloudflare_account_id"
TF_VAR_cloudflare_api_token="your_cloudflare_api_token"
TF_VAR_upstream_otlp_endpoint="https://otlp-gateway-prod-us-east-0.grafana.net/otlp"
TF_VAR_upstream_auth_header="Basic <base64_encoded_instance_and_token>"
